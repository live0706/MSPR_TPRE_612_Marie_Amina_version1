# Base de donnees
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=obrail
DATABASE_URL=postgresql://postgres:change_me@db:5432/obrail

# API
APP_ENV=development
APP_VERSION=2.1.0
LOG_LEVEL=INFO
ENABLE_PROMETHEUS=true
APP_LOG_PATH=/app/data/logs/api.log
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Frontend et supervision
API_URL=http://api:8000
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# CD / images publiees
GHCR_OWNER=live0706
IMAGE_TAG=latest

# ETL
TRANSITLAND_ENABLED=false
